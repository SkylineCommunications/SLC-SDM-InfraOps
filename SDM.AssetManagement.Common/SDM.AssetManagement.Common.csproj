<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Skyline.DataMiner.SDM.AssetManagement.Common</AssemblyName>
    <RootNamespace>Skyline.DataMiner.SDM.AssetManagement.Common</RootNamespace>
    <VersionSuffix Condition="'$(Configuration)' == 'Debug'">dev-043</VersionSuffix>
    <AssemblyVersion>0.2.3.43</AssemblyVersion>
    <VersionPrefix>1.0.1</VersionPrefix>
    <PackageTags>Skyline;DataMiner</PackageTags>
    <PackageProjectUrl>https://skyline.be</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageIcon>Icon.png</PackageIcon>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Authors>SkylineCommunications</Authors>
    <Company>Skyline Communications</Company>
    <Description>Standard API for InfraOps</Description>
    <UserSecretsId>9724ddd7-646d-4a51-b198-2dd3916f54ba</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="LICENSE.txt" Pack="true" PackagePath="" />
    <None Include="nuget\Icon.png" Pack="true" PackagePath="" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Skyline.DataMiner.SDM" />
    <PackageReference Include="Skyline.DataMiner.Utils.SecureCoding.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
   <PackageReference Include="Newtonsoft.Json" />
		<PackageReference Include="Skyline.DataMiner.SDM.Linq" />
		<!--<PackageReference Include="Skyline.DataMiner.SDM.SourceGenerator" Version="0.3.1" OutputItemType="Analyzer" ReferenceoutputAssembly="false" />-->
		<PackageReference Include="Skyline.DataMiner.Utils.DOM" />
		<PackageReference Include="Skyline.DataMiner.Utils.PerformanceAnalyzer" />
		<PackageReference Include="Skyline.DataMiner.Utils.SecureCoding" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Skyline.DataMiner.SDM.AssetManagement.GQI" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\SDM.InfraOps.Core\SDM.InfraOps.Core.csproj" />
    <ProjectReference Include="..\SDM.FacilityManagement.Common\SDM.FacilityManagement.Common.csproj" />
  </ItemGroup>

  <!-- Can be used to set the location of your local nuget store to copy to -->
  <Import Project="../Directory.Build.props.user" Condition="Exists('../Directory.Build.props.user')" />
  <Target Name="CopyNuGetPackage" AfterTargets="Pack" Condition="'$(NuGetStorePath)' != '' and '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <Copy SourceFiles="$(OutputPath)..\$(PackageId).$(PackageVersion).nupkg" DestinationFolder="$(NuGetStorePath)\$(PackageId)" />
  </Target>
</Project>
