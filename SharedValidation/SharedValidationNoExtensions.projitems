<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects Condition="'$(MSBuildVersion)' == '' Or '$(MSBuildVersion)' &lt; '16.0'">$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>D9129695-BB2C-4F4C-B680-88FC377594DC</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>SharedCommonLibrary</Import_RootNamespace>
  </PropertyGroup>
  <!-- Excludes the 3 public extension classes (SdmFilterExtensions, SDMObjectReferenceExtensions,
       BulkRepositoryQueryExtensions) to avoid CS0121 ambiguity in projects that reference
       SDM.FacilityManagement.Common (which already exposes those as public types). -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Converters\InfraOpsContractResolver.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Converters\InfraOpsSerialization.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Converters\SdmObjectReferenceConverter.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Validation\IEntityTracking.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Validation\BulkValidationException.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Validation\ChangeTrackingBase.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Validation\IChangeTracking.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Validation\ValidationExtensions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Validation\ValidationResultExtensions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Validation\InfraOpsException.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Validation\NumericValidator.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Validation\ValidationException.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Validation\Validator.cs" />
    <Compile Include="..\SharedValidation\DomInstanceField\ChangeTrackingArrayField.cs" />
    <Compile Include="..\SharedValidation\DomInstanceField\ChangeTrackingField.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)DomInstanceField\ChangeTrackingFieldHandler.cs" />
    <Compile Include="..\SharedValidation\DomInstanceField\ChangeTrackingStringField.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)DomInstanceField\IChangeTrackingField.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)DomInstanceField\IDomInstanceFieldApplyChanges.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Validation\ValidationResult.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Validation\ValidatorContext.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Middleware\IdentifierMiddleware.cs" />
  </ItemGroup>
</Project>